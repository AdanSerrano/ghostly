{
  "name": "@ghostly-ui/react",
  "version": "0.2.4",
  "description": "React components for Ghostly skeleton loaders",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "peerDependencies": {
    "@ghostly-ui/core": ">=0.2.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "skeleton",
    "loading",
    "react",
    "shimmer",
    "zero-config"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/AdanSerrano/ghostly",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/AdanSerrano/ghostly/issues"
  },
  "homepage": "https://github.com/AdanSerrano/ghostly#readme",
  "sideEffects": false
}
