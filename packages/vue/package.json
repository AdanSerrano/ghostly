{
  "name": "@ghostly-ui/vue",
  "version": "1.0.0",
  "description": "Vue 3 components for Ghostly skeleton loaders",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "peerDependencies": {
    "@ghostly-ui/core": ">=1.0.0",
    "vue": ">=3.3.0"
  },
  "devDependencies": {
    "vue": "^3.5.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "skeleton",
    "loading",
    "vue",
    "shimmer",
    "zero-config"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/AdanSerrano/ghostly",
    "directory": "packages/vue"
  },
  "bugs": {
    "url": "https://github.com/AdanSerrano/ghostly/issues"
  },
  "homepage": "https://github.com/AdanSerrano/ghostly#readme",
  "sideEffects": false
}
