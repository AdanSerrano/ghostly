{
  "name": "@ghostly-ui/core",
  "version": "0.2.0",
  "description": "Zero-config skeleton loaders. Wrap your component, done.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./css": "./dist/ghostly.css",
    "./tailwind": {
      "import": {
        "types": "./dist/tailwind.d.ts",
        "default": "./dist/tailwind.js"
      },
      "require": {
        "types": "./dist/tailwind.d.cts",
        "default": "./dist/tailwind.cjs"
      }
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": ["*.css"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "peerDependencies": {
    "tailwindcss": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
  "devDependencies": {
    "tailwindcss": "^4.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "skeleton",
    "loading",
    "placeholder",
    "shimmer",
    "css",
    "zero-config"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/AdanSerrano/ghostly",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/AdanSerrano/ghostly/issues"
  },
  "homepage": "https://github.com/AdanSerrano/ghostly#readme"
}
