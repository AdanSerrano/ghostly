{
  "name": "ghostly-monorepo",
  "private": true,
  "workspaces": ["packages/*", "playground"],
  "scripts": {
    "dev": "bun run --filter playground dev",
    "build": "bun run build:core && bun run build:react",
    "build:core": "bun run --filter ghostly build",
    "build:react": "bun run --filter @ghostly/react build",
    "lint": "eslint packages/*/src/**/*.{ts,tsx}",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc -b",
    "clean": "rm -rf packages/*/dist playground/.next",
    "prepublish": "bun run build"
  },
  "devDependencies": {
    "@types/node": "^22.19.15",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "prettier": "^3.8.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20",
    "bun": ">=1.2"
  }
}
