{
  "name": "ghostly-monorepo",
  "private": true,
  "workspaces": ["packages/*", "website"],
  "scripts": {
    "dev": "bun run --filter website dev",
    "build": "bun run build:core && bun run build:react",
    "build:core": "bun run --filter @ghostly-ui/core build",
    "build:react": "bun run --filter @ghostly-ui/react build",
    "lint": "eslint packages/*/src/**/*.{ts,tsx}",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc -b",
    "clean": "rm -rf packages/*/dist website/.next",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublish": "bun run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.19.15",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.0",
    "eslint": "^9.39.4",
    "jsdom": "^28.1.0",
    "prettier": "^3.8.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.33.1",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=20",
    "bun": ">=1.2"
  }
}
